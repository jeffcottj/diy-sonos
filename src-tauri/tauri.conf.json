{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIY Sonos",
  "version": "1.0.0",
  "identifier": "dev.jeffcottj.diy-sonos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DIY Sonos",
        "width": 1100,
        "height": 750,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "dmg": {
        "background": null
      }
    },
    "linux": {
      "deb": {},
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PLACEHOLDER_PUBKEY_REPLACE_WITH_MINISIGN_PUBKEY",
      "endpoints": ["https://github.com/jeffcottj/diy-sonos/releases/latest/download/latest.json"]
    }
  }
}
